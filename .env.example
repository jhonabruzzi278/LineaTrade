# Copia este archivo a .env.local y completa con los valores de:
#   npx supabase status
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Clave pública del par VAPID usado para Web Push (recordatorio de trade
# diario, ver supabase/functions/send-trade-reminders). Es la mitad PÚBLICA
# del par — segura de exponer en el bundle del cliente. Generar con
# `npx web-push generate-vapid-keys`; la privada va como secret de la Edge
# Function (VAPID_PRIVATE_KEY), nunca acá.
VITE_VAPID_PUBLIC_KEY=
